# SMTP (port 587 with STARTTLS)
SMTP_HOST=mail.example.com
SMTP_PORT=587
SMTP_USER=you@example.com
SMTP_PASS=your-password-or-app-password
# Recipient(s), comma-separated; settings.email_to in the database overrides this
EMAIL_TO=you@example.com

# Email look (optional)
EMAIL_TITLE="Your Site"              # the title at the top of the email
EMAIL_FROM_NAME="Your Site Price Monitor"
EMAIL_FROM_ADDRESS=you@example.com    # defaults to SMTP_USER
EMAIL_KICKER="Price monitor"         # the small label above the heading (empty: none)
EMAIL_SUBJECT=                       # one email per product; its subject, {product} filled in (default: Listing updates for {product})
EMAIL_FOOTER="A notification from your price monitor."
DASHBOARD_URL=https://example.com/dashboard/price-monitor

# Optional
# ENVIRONMENT=production   # shown next to "PRICE MONITOR" in the email, in capitals (default: the machine's name)
# PLATFORMS=olx,vinted    # this copy runs only these (default: all; none: only what --platforms asks)
# PRICE_DROP_MIN_PCT=3     # report drops of at least this many percent
# TICK_SECONDS=60          # how often the local loop checks what's due

# Facebook Marketplace works logged out from a home connection. A server gets the login page, so
# there it needs a logged-in session: a browser's cookies for facebook.com, ideally a spare
# account's, as  c_user=...; xs=...; datr=...  and facebook in PLATFORMS. Optional: the user agent
# of that browser.
FACEBOOK_COOKIES=
# FACEBOOK_USER_AGENT=

# eBay works through its official Browse API: a free Production keyset from developer.ebay.com.
# A listing's price is the total delivered to EBAY_SHIP_TO: price + shipping, plus, from outside
# the EU, customs duty (per search: options {"duty_pct": N}), import VAT and a courier's fee.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# EBAY_SHIP_TO=RO
# IMPORT_VAT_PCT=21
# IMPORT_FEE_RON=0

# MySQL instead of the local SQLite file (on the server these come from .env.server)
# MYSQL_HOST=localhost
# MYSQL_PORT=3306
# MYSQL_USER=
# MYSQL_PASSWORD=
# MYSQL_DATABASE=

# Server only (.env.server): how often cron wakes the monitor; each search's interval decides
# whether it runs
# CRON_SCHEDULE="*/5 * * * *"
